<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
每日 21:00 (台北) 觸發盤後摘要 endpoint。詳見 local.crypto-premarket-trigger.plist 的設計說明。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.crypto-evening-trigger</string>

    <key>ProgramArguments</key>
    <!-- 從 .env 讀 CSP_INTERNAL_KEY 帶上 X-Internal-Key header（金鑰未設時為空，endpoint fail-open） -->
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>KEY="$(grep -E '^CSP_INTERNAL_KEY=' "$HOME/Documents/plate/crypto-signal-pro/.env" 2>/dev/null | head -1 | cut -d= -f2-)"; exec /usr/bin/curl -s -X POST -H "X-Internal-Key: $KEY" http://localhost:8000/api/internal/trigger-evening-summary</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/kentsai/Documents/plate/crypto-signal-pro/logs/launchd-evening.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kentsai/Documents/plate/crypto-signal-pro/logs/launchd-evening-error.log</string>
</dict>
</plist>
